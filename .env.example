# ─────────────────────────────────────────────────────────────
#  Join4Join bot — configuration
#  Copy this file to ".env" and fill in the values.
# ─────────────────────────────────────────────────────────────

# Your Discord bot token (https://discord.com/developers/applications)
TOKEN=YOUR_BOT_TOKEN

# Your Join4Join API key (https://join4join.xyz/dashboard/settings?developer)
# Every user who uses your bot is automatically affiliated to this key:
# you earn rewards each time they farm. Keep it secret.
API_KEY=YOUR_API_KEY

# The invite link people use to add YOUR bot to their servers
BOT_INVITE_LINK=https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&scope=bot+applications.commands&permissions=0

# ── Optional ──────────────────────────────────────────────────

# Register slash commands instantly on a single test server (dev only).
# Leave empty to register them globally (can take up to 1h to appear or remove and add the bot again).
GUILD_ID=

# Discord user IDs allowed to run admin-only commands (comma separated)
ADMIN=

# Discord user IDs allowed to run owner-only commands (comma separated)
OWNER=

# ── Branding (no need to change) ──────────────────────────────
API_URL=https://join4join.xyz
URL=https://join4join.xyz
SUPPORT_URL=https://join4join.xyz/support
FOOTER="https://join4join.xyz • (C) 2026 Join4Join • Hosted by bot-hosting.net"
EMBED_COLOR=#e84e4b
